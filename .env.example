# Copy this file to .env and fill in your values
# .env is NEVER committed to GitHub

# Django
DJANGO_SECRET_KEY=your-secret-key-here-generate-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,YOUR_VM_IP_ADDRESS

# Superuser — created automatically on first container start
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=changeme
